# Resend API key (send-only is enough). Sender must be on a verified domain.
RESEND_API_KEY=re_xxx
MAIL_FROM=Frazile Blog <blog@frazile.xyz>
MAIL_REPLY_TO=

# First-run admin account (ignored once an admin exists).
ADMIN_USERNAME=frazile
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ntfy topic for new comments / members (empty = off).
NTFY_URL=https://fzntfy.frazile.app/frazileblog

# Optional, for tools/addimages.py (photo search). tools/publish.py and
# addimages.py also read ADMIN_USERNAME/ADMIN_PASSWORD above and BLOG_URL
# (default http://127.0.0.1:8092).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
